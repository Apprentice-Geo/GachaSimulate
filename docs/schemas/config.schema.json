{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gacha simulation config",
  "type": "object",
  "description": "Schema for config.json. Reference checks between item ids and pool ids, and pool probability sums, are enforced by the Python validator rather than by this schema.",
  "required": ["initial", "items", "pools"],
  "properties": {
    "meta": {
      "type": "object",
      "description": "Optional metadata consumed by reporting tools. The validator does not enforce a fixed meta shape."
    },
    "initial": {
      "type": "object",
      "description": "Initial runtime state. begin_pool must name an existing pool.",
      "required": ["begin_pool"],
      "properties": {
        "begin_pool": {
          "type": "string",
          "description": "Pool id used as the initial main pool. The validator checks that it exists in pools."
        },
        "actions": {
          "$ref": "#/$defs/actions"
        }
      }
    },
    "items": {
      "type": "object",
      "description": "Item definitions keyed by item id.",
      "required": ["draw_count"],
      "additionalProperties": {
        "$ref": "#/$defs/item"
      }
    },
    "pools": {
      "type": "object",
      "description": "Pool definitions keyed by pool id. The validator requires at least one pool and checks that probabilities in each pool sum to 1.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/pool"
      }
    },
    "stages": {
      "type": "object",
      "description": "Optional draw-stage conditions keyed by stage id.",
      "additionalProperties": {
        "$ref": "#/$defs/stage"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "on_acquire": {
          "$ref": "#/$defs/actions",
          "description": "Actions executed once for each acquired unit of this item."
        },
        "resolve": {
          "$ref": "#/$defs/resolve"
        }
      }
    },
    "resolve": {
      "type": "object",
      "required": ["retain", "actions"],
      "properties": {
        "retain": {
          "type": "integer",
          "minimum": 0
        },
        "actions": {
          "$ref": "#/$defs/actions",
          "description": "Actions executed for each resolved duplicate item."
        }
      }
    },
    "pool": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/poolEntry"
          }
        }
      }
    },
    "poolEntry": {
      "type": "object",
      "required": ["probability"],
      "properties": {
        "probability": {
          "type": "number",
          "minimum": 0
        },
        "actions": {
          "$ref": "#/$defs/actions"
        }
      }
    },
    "stage": {
      "type": "object",
      "required": ["condition"],
      "properties": {
        "once": {
          "type": "boolean",
          "default": false
        },
        "condition": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "action": {
      "oneOf": [
        {
          "$ref": "#/$defs/itemAction"
        },
        {
          "$ref": "#/$defs/poolAction"
        },
        {
          "$ref": "#/$defs/terminationAction"
        }
      ]
    },
    "itemAction": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["add_item", "reduce_item", "set_item"]
        },
        "id": {
          "type": "string",
          "description": "Item id. The validator checks that it exists in items."
        },
        "amount": {
          "type": "integer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "set_item"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "amount": {
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "amount": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "poolAction": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["draw_pool", "pool_change"]
        },
        "id": {
          "type": "string",
          "description": "Pool id. The validator checks that it exists in pools."
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "terminationAction": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "termination"
        },
        "reason": {
          "type": "string"
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/predicateCondition"
        },
        {
          "$ref": "#/$defs/logicCondition"
        }
      ]
    },
    "predicateCondition": {
      "type": "object",
      "required": ["type", "subject", "id", "op", "value"],
      "properties": {
        "type": {
          "const": "predicate"
        },
        "subject": {
          "enum": ["item"]
        },
        "id": {
          "type": "string",
          "description": "Item id. The validator checks that it exists in items."
        },
        "op": {
          "enum": [">=", ">", "==", "<=", "<", "!="]
        },
        "value": {
          "type": "integer"
        },
        "actions": {
          "$ref": "#/$defs/actions"
        }
      }
    },
    "logicCondition": {
      "type": "object",
      "required": ["type", "op", "conditions"],
      "properties": {
        "type": {
          "const": "logic"
        },
        "op": {
          "enum": ["AND", "OR"]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "actions": {
          "$ref": "#/$defs/actions"
        }
      }
    }
  }
}
