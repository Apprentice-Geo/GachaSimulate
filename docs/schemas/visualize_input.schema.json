{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gacha simulation visualization input",
  "type": "object",
  "description": "Schema for visualize input json.",
  "additionalProperties": false,
  "required": [
    "title",
    "target",
    "result_item",
    "total",
    "runs",
    "note",
    "statistic",
    "termination_reason",
    "timestamp",
    "values",
    "cumulative",
    "price",
    "unit"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "result_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "runs": {
      "type": "integer",
      "minimum": 1
    },
    "note": {
      "type": "string"
    },
    "statistic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "P5",
        "P25",
        "P50",
        "P75",
        "P95",
        "MIN",
        "MEAN_LEVEL",
        "MEAN",
        "MAX"
      ],
      "properties": {
        "P5": {
          "type": "integer",
          "minimum": 0
        },
        "P25": {
          "type": "integer",
          "minimum": 0
        },
        "P50": {
          "type": "integer",
          "minimum": 0
        },
        "P75": {
          "type": "integer",
          "minimum": 0
        },
        "P95": {
          "type": "integer",
          "minimum": 0
        },
        "MIN": {
          "type": "integer",
          "minimum": 0
        },
        "MEAN": {
          "type": "number",
          "minimum": 0
        },
        "MEAN_LEVEL": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "MAX": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "termination_reason": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "proportion"],
        "properties": {
          "reason": {
            "type": "string"
          },
          "proportion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "timestamp": {
      "type": "integer"
    },
    "values": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cumulative": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "price": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    }
  }
}
