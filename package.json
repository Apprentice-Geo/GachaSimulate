{
  "name": "gachasimulate",
  "version": "1.0.0",
  "packageManager": "pnpm@11.3.0",
  "description": "",
  "main": "out/main/index.js",
  "private": true,
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"docs/schemas/**/*.json\" \"*.{ts,json,html,mjs}\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"docs/schemas/**/*.json\" \"*.{ts,json,html,mjs}\" \"packages/**/*.ts\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && electron-vite build",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:visualize:cdf": "tsx --test src/visualize/test/cdf.test.ts src/visualize/test/analysis.test.ts",
    "test:simulation": "tsx --test src/main/config_manager.test.ts src/main/simulation.test.ts src/main/result_editor.test.ts src/renderer/simulation_items.test.ts",
    "test:e2e": "tsx src/visualize/test/run_e2e.ts",
    "export:cdf": "tsx src/visualize/export/export_cdf.ts",
    "test:compiler": "pnpm --dir packages/config-compiler test",
    "test:cli": "pnpm --dir packages/cli test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apprentice-Geo/GachaSimulate.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Apprentice-Geo/GachaSimulate/issues"
  },
  "homepage": "https://github.com/Apprentice-Geo/GachaSimulate#readme",
  "dependencies": {
    "@gachasimulate/config-compiler": "workspace:*",
    "@remotion/bundler": "^4.0.484",
    "@remotion/renderer": "^4.0.484",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.2.6",
    "recharts": "^3.8.1",
    "remotion": "^4.0.484",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@gachasimulate/cli": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.3.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "playwright": "1.61.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.12"
  }
}
