{
  "name": "gachasimulate",
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "description": "",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "pnpm run build:packages && electron-vite dev",
    "hooks:install": "git config core.hooksPath .githooks",
    "dev:web": "vite",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,mjs,cjs,css,json}\" \"e2e/**/*.{ts,tsx,js,mjs,cjs,json}\" \"docs/schemas/**/*.json\" \"*.{ts,js,mjs,cjs,json,html}\" \"packages/*/{src,test}/**/*.{ts,tsx,js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,cjs,css,json}\" \"e2e/**/*.{ts,tsx,js,mjs,cjs,json}\" \"docs/schemas/**/*.json\" \"*.{ts,js,mjs,cjs,json,html}\" \"packages/*/{src,test}/**/*.{ts,tsx,js,mjs,cjs,json}\"",
    "lint": "eslint \"src/**/*.{ts,tsx,js,mjs,cjs}\" \"e2e/**/*.{ts,tsx,js,mjs,cjs}\" \"packages/*/{src,test}/**/*.{ts,tsx,js,mjs,cjs}\" \"*.{ts,js,mjs,cjs}\"",
    "typecheck": "pnpm run build:packages && tsc --noEmit && pnpm --recursive --filter './packages/*' typecheck",
    "build": "pnpm run build:packages && tsc --noEmit && electron-vite build",
    "package:win": "pnpm run build && node node_modules/electron-builder/cli.js --win nsis",
    "build:web": "tsc --noEmit && vite build",
    "capture:ui": "pnpm run build:packages && electron-vite build && tsx src/dev/capture_ui.ts",
    "preview": "vite preview",
    "test:visualize:cdf": "tsx --test src/visualize/test/cdf.test.ts src/visualize/test/analysis.test.ts",
    "test:electron-layout": "pnpm run build:packages && electron-vite build && tsx --test src/dev/electron_layout.test.ts",
    "test:simulation": "pnpm run build:packages && tsx --test src/main/config_download.test.ts src/main/config_manager.test.ts src/main/native_pipeline.test.ts src/main/simulation.test.ts src/main/result_editor.test.ts src/renderer/simulation_items.test.ts",
    "test:e2e": "tsx src/visualize/test/run_e2e.ts",
    "export:cdf": "tsx src/export/export_cdf.ts",
    "test:compiler": "pnpm --dir packages/config-compiler test",
    "test:config-repository-contract": "pnpm --dir packages/config-repository-contract test",
    "test:packages": "pnpm --dir packages/config-compiler test && pnpm --dir packages/config-repository-contract test",
    "build:compiler": "pnpm --dir packages/config-compiler build",
    "build:packages": "pnpm --dir packages/config-repository-contract build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apprentice-Geo/GachaSimulate.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Apprentice-Geo/GachaSimulate/issues"
  },
  "homepage": "https://github.com/Apprentice-Geo/GachaSimulate#readme",
  "build": {
    "appId": "com.gachasimulate.app",
    "productName": "GachaSimulate",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "build/native",
        "to": "native"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@gachasimulate/config-compiler": "workspace:*",
    "@gachasimulate/config-repository-contract": "workspace:*",
    "@remotion/bundler": "^4.0.484",
    "@remotion/renderer": "^4.0.484",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.2.6",
    "recharts": "^3.8.1",
    "remotion": "^4.0.484",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.9.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.3.0",
    "playwright": "1.61.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.12"
  }
}
