{
  "name": "@gachasimulate/cli",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "gachasimulate": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --dir ../config-compiler build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm build && tsx --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@gachasimulate/config-compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
