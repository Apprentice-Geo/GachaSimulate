{
  "name": "@gachasimulate/config-repository-contract",
  "version": "1.0.0",
  "description": "GachaSimulate configuration repository protocol validation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm --dir ../config-compiler build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm --dir ../config-compiler build && tsx --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@gachasimulate/config-compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
